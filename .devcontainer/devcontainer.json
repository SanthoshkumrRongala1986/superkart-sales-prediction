{
  "name": "SuperKart Codespace",
  "dockerComposeFile": ["docker-compose.yml"],
  "service": "backend",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "runServices": ["backend", "frontend"],
  "postCreateCommand": "docker-compose up -d --build backend frontend",
  "postStartCommand": "docker-compose ps",
  "forwardPorts": [7860, 8501],
  "portsAttributes": {
    "7860": {
      "label": "SuperKart backend (Flask / Gunicorn)"
    },
    "8501": {
      "label": "SuperKart frontend (Streamlit)"
    }
  },
  "remoteUser": "vscode"
}
